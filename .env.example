# ── Aplicacao ────────────────────────────────────────────────────────────────
APP_VERSION=0.1.0
WEB_PORT=5173

# ── Autenticacao ─────────────────────────────────────────────────────────────
ADMIN_USER=hexanetworks
# Gere com: ./scripts/gen-secrets.sh 'sua-senha'  — ATENCAO: escape cada $ do hash como $$
# (o docker compose interpola $VAR no .env; sem escapar, o hash chega truncado).
ADMIN_PASSWORD_HASH=
JWT_SECRET=
# true quando estiver atras de TLS (Traefik/nginx). Em HTTP puro tem que ser false.
COOKIE_SECURE=false

# ── BGP ──────────────────────────────────────────────────────────────────────
GOBGP_VERSION=v4.7.0
# Capabilities do OPEN que o GoBGP nao deixa configurar (sao patch no build).
# Equipamento antigo derruba a sessao ao ve-las em vez de ignorar (RFC 5492).
# 75 = software-version: sem uso operacional, e o GoBGP a forca em iBGP.
DISABLE_CAP_SOFTWARE_VERSION=1
# 6 = extended-message (RFC 8654), so existe da v4.7.0 em diante.
DISABLE_CAP_EXTENDED_MESSAGE=0
GRPC_LISTEN=127.0.0.1:50051
GOBGP_LOG_LEVEL=info
LOCAL_ASN=65000
ROUTER_ID=198.51.100.10
BGP_LISTEN_PORT=179

# ── Politica de anuncio ──────────────────────────────────────────────────────
# Next-hop dos prefixos anunciados (o cliente aponta para discard/Null0).
DEFAULT_NEXT_HOP=192.0.2.1
# Communities padrao (CSV). 65535:666 = BLACKHOLE (RFC 7999).
DEFAULT_COMMUNITIES=65535:666

# ── Guard-rails ──────────────────────────────────────────────────────────────
# Prefixos que NUNCA podem ser anunciados (CSV). Coloque aqui os blocos da Hexa
# e dos clientes: qualquer rota contida neles e recusada na validacao.
PROTECTED_PREFIXES=
# Teto global de rotas no controller.
MAX_ROUTES=50000
# Prefixo IPv4 mais curto aceito (24 = recusa /23 e maiores).
MIN_PREFIX_LEN_V4=24
# Intervalo (s) do loop de reconciliacao SQLite -> RIB.
RECONCILE_INTERVAL=60
